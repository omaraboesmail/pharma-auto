{
  "openapi": "3.1.0",
  "info": {
    "title": "Pharma Auto SaaS API",
    "version": "1.0.0",
    "description": "Tenant-scoped Phase 1 entitlement, quota, OCR and canonical-candidate API. It never receives Genius credentials or exposes an ERP write operation. Production Connector calls require mTLS plus all six signed-request headers declared below."
  },
  "servers": [
    {
      "url": "https://api.pharma-auto.invalid"
    }
  ],
  "security": [
    {
      "mutualTls": [],
      "tenantIdHeader": [],
      "connectorIdHeader": [],
      "requestTimestampHeader": [],
      "requestNonceHeader": [],
      "contentSha256Header": [],
      "requestSignatureHeader": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "security": [],
        "operationId": "getSaasLiveness",
        "responses": {
          "200": {
            "description": "SaaS API is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/entitlements/current": {
      "get": {
        "operationId": "getCurrentEntitlement",
        "responses": {
          "200": {
            "description": "ES256-signed active entitlement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/entitlement.v1.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/signing-keys/current": {
      "get": {
        "operationId": "getCurrentEntitlementSigningKey",
        "responses": {
          "200": {
            "description": "Current ES256 SubjectPublicKeyInfo public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigningKeyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/ocr/jobs/{jobId}/process": {
      "post": {
        "operationId": "processOcrJob",
        "description": "Each ordered image entry is one normalized, billable invoice page.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessOcrRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent OCR job result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcrJobResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/ocr/jobs/{jobId}": {
      "get": {
        "operationId": "getOcrJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped OCR job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcrJobResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "OCR job was not found for the authenticated tenant"
          }
        }
      }
    },
    "/api/v1/canonical-products/search": {
      "post": {
        "operationId": "searchCanonicalProducts",
        "description": "Returns at most 25 canonical candidates; no result is a final local Genius identity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CanonicalSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filtered candidate shortlist with hard mismatches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTls": {
        "type": "mutualTLS",
        "description": "Production requests require the active Connector client certificate."
      },
      "tenantIdHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Tenant-Id",
        "description": "Tenant UUID bound to the Connector registration."
      },
      "connectorIdHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Connector-Id",
        "description": "Active Connector registration UUID."
      },
      "requestTimestampHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Timestamp",
        "description": "Unix timestamp in seconds; accepted within a five-minute clock-skew window."
      },
      "requestNonceHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Nonce",
        "description": "Single-use Connector nonce containing 16 to 128 characters."
      },
      "contentSha256Header": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Content-SHA256",
        "description": "Lowercase SHA-256 hex digest of the exact request body."
      },
      "requestSignatureHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Signature",
        "description": "Base64url HMAC-SHA256 over uppercase method, path, Unix timestamp, nonce and body digest, joined with LF characters."
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "storageProvider",
          "ocrProvider",
          "fixtureMode",
          "geniusWritesEnabled"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "PharmaAuto.Saas.Api"
          },
          "storageProvider": {
            "type": "string"
          },
          "ocrProvider": {
            "type": "string"
          },
          "fixtureMode": {
            "type": "boolean"
          },
          "geniusWritesEnabled": {
            "const": false
          }
        }
      },
      "SigningKeyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "keyId", "subjectPublicKeyInfoPem"],
        "properties": {
          "algorithm": {
            "const": "ES256"
          },
          "keyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subjectPublicKeyInfoPem": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ProcessOcrRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceSha256", "pages"],
        "properties": {
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pages": {
            "type": "array",
            "description": "Ordered normalized image pages. One array entry consumes one OCR quota page.",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "mimeType", "sha256", "base64Data"],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "mimeType": {
                  "enum": ["image/jpeg", "image/png"]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "base64Data": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              }
            }
          }
        }
      },
      "OcrJobResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "state",
          "pageCount",
          "sourceSha256",
          "providerModel",
          "failureCode",
          "result",
          "createdAt",
          "updatedAt",
          "geniusWritePerformed"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": ["RESERVED", "PROCESSING", "COMPLETED", "FAILED"]
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "providerModel": {
            "type": ["string", "null"]
          },
          "failureCode": {
            "type": ["string", "null"]
          },
          "result": {},
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "geniusWritePerformed": {
            "const": false
          }
        }
      },
      "PharmaAttributes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activeIngredient": {
            "type": ["string", "null"]
          },
          "strength": {
            "type": ["string", "null"]
          },
          "dosageForm": {
            "type": ["string", "null"]
          },
          "pack": {
            "type": ["string", "null"]
          },
          "manufacturer": {
            "type": ["string", "null"]
          }
        }
      },
      "CanonicalSearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "locale", "limit"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "vendorItemCode": {
            "type": ["string", "null"],
            "maxLength": 100
          },
          "attributes": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PharmaAttributes"
              },
              {
                "type": "null"
              }
            ]
          },
          "locale": {
            "enum": ["ar-EG", "en-EG"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "CanonicalCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonicalProductId",
          "displayName",
          "attributes",
          "reasonCodes",
          "hardMismatches",
          "requiresLocalResolution"
        ],
        "properties": {
          "canonicalProductId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "attributes": {
            "$ref": "#/components/schemas/PharmaAttributes"
          },
          "reasonCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "EXACT_IDENTIFIER",
                "EXACT_NORMALIZED_NAME",
                "LEXICAL_SHORTLIST",
                "SEMANTIC_RETRIEVAL",
                "STRUCTURED_ATTRIBUTES",
                "CANONICAL_SHORTLIST"
              ]
            }
          },
          "hardMismatches": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["ACTIVE_INGREDIENT", "STRENGTH", "DOSAGE_FORM", "PACK"]
            }
          },
          "requiresLocalResolution": {
            "const": true
          }
        }
      },
      "CanonicalSearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidates",
          "localItemIdentitySelected",
          "requiresLocalResolution",
          "geniusWritePerformed"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/CanonicalCandidate"
            }
          },
          "localItemIdentitySelected": {
            "const": false
          },
          "requiresLocalResolution": {
            "const": true
          },
          "geniusWritePerformed": {
            "const": false
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Connector authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
