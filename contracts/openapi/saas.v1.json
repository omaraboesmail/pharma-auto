{
  "openapi": "3.1.0",
  "info": {
    "title": "Pharma Auto SaaS API",
    "version": "1.0.0",
    "description": "Tenant-scoped Phase 1 entitlement, quota, OCR and canonical-candidate API. It never receives Genius credentials or exposes an ERP write operation."
  },
  "servers": [
    {
      "url": "https://api.pharma-auto.invalid"
    }
  ],
  "security": [
    {
      "mutualTls": [],
      "signedConnectorRequest": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "security": [],
        "operationId": "getSaasLiveness",
        "responses": {
          "200": {
            "description": "SaaS API is alive"
          }
        }
      }
    },
    "/api/v1/entitlements/current": {
      "get": {
        "operationId": "getCurrentEntitlement",
        "responses": {
          "200": {
            "description": "ES256-signed active entitlement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/entitlement.v1.schema.json"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/signing-keys/current": {
      "get": {
        "operationId": "getCurrentEntitlementSigningKey",
        "responses": {
          "200": {
            "description": "Current ES256 SubjectPublicKeyInfo public key"
          }
        }
      }
    },
    "/api/v1/ocr/jobs/{jobId}/process": {
      "post": {
        "operationId": "processOcrJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessOcrRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent OCR result or terminal failure"
          },
          "402": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/ocr/jobs/{jobId}": {
      "get": {
        "operationId": "getOcrJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped OCR job status"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/canonical-products/search": {
      "post": {
        "operationId": "searchCanonicalProducts",
        "description": "Returns candidates only; no result is a final local Genius identity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CanonicalSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filtered candidate shortlist with hard mismatches"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTls": {
        "type": "mutualTLS"
      },
      "signedConnectorRequest": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Signature",
        "description": "HMAC-SHA256 over method, path, timestamp, nonce and content hash."
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "ProcessOcrRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceSha256", "pages"],
        "properties": {
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "mimeType", "sha256", "base64Data"],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "mimeType": {
                  "enum": ["image/jpeg", "image/png", "application/pdf"]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "base64Data": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              }
            }
          }
        }
      },
      "CanonicalSearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "vendorItemCode", "attributes", "locale", "limit"],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "vendorItemCode": {
            "type": ["string", "null"],
            "maxLength": 100
          },
          "attributes": {
            "type": "object"
          },
          "locale": {
            "enum": ["ar-EG", "en-EG"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
