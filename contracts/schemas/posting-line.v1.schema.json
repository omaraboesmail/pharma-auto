{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pharma-auto.invalid/v1/posting-line.schema.json",
  "title": "Posting Line v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postingLineId",
    "sourceLineId",
    "splitIndex",
    "postingSequence",
    "itemReference",
    "quantity",
    "bonusQuantity",
    "expiryDate",
    "batch",
    "commercialValues",
    "ocrCommercialEvidence"
  ],
  "properties": {
    "postingLineId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceLineId": {
      "type": "string",
      "format": "uuid"
    },
    "splitIndex": {
      "type": "integer",
      "minimum": 1
    },
    "postingSequence": {
      "type": "integer",
      "minimum": 1
    },
    "itemReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quantity": {
      "$ref": "https://schemas.pharma-auto.invalid/v1/commercial-values.schema.json#/$defs/decimalString"
    },
    "bonusQuantity": {
      "$ref": "https://schemas.pharma-auto.invalid/v1/commercial-values.schema.json#/$defs/decimalString"
    },
    "expiryDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "batch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "commercialValues": {
      "$ref": "https://schemas.pharma-auto.invalid/v1/commercial-values.schema.json"
    },
    "ocrCommercialEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPurchaseUnitPrice",
        "rawDiscount1Percentage",
        "rawDiscount2Percentage",
        "rawSellingUnitPrice"
      ],
      "properties": {
        "rawPurchaseUnitPrice": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawDiscount1Percentage": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawDiscount2Percentage": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawSellingUnitPrice": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviewCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorId",
        "reason",
        "editedAt",
        "changedFields"
      ],
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "editedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quantity",
              "expiryDate",
              "purchaseUnitPrice",
              "discount1Percentage",
              "discount2Percentage",
              "sellingUnitPrice"
            ]
          }
        }
      }
    }
  }
}
