{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pharma-auto.invalid/v1/ocr-result.schema.json",
  "title": "OCR Result v1",
  "description": "Canonical validated Gemini OCR evidence for v1. It never contains a final Genius item or vendor identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "jobId",
    "provider",
    "document",
    "supplier",
    "invoiceNumber",
    "invoiceDate",
    "currency",
    "sourceLines",
    "totals",
    "qualityFlags"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "resultId": {
      "type": "string",
      "format": "uuid"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "processedAt"
      ],
      "properties": {
        "name": {
          "const": "GEMINI"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "processedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "pageCount",
        "mimeTypes"
      ],
      "properties": {
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "mimeTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image/jpeg",
              "image/png",
              "application/pdf"
            ]
          }
        }
      }
    },
    "supplier": {
      "$ref": "#/$defs/textField"
    },
    "invoiceNumber": {
      "$ref": "#/$defs/textField"
    },
    "invoiceDate": {
      "$ref": "#/$defs/dateField"
    },
    "currency": {
      "$ref": "#/$defs/currencyField"
    },
    "sourceLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sourceLine"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtotal",
        "discount",
        "tax",
        "total"
      ],
      "properties": {
        "subtotal": {
          "$ref": "#/$defs/decimalField"
        },
        "discount": {
          "$ref": "#/$defs/decimalField"
        },
        "tax": {
          "$ref": "#/$defs/decimalField"
        },
        "total": {
          "$ref": "#/$defs/decimalField"
        }
      }
    },
    "qualityFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "LOW_IMAGE_QUALITY",
          "ROTATED_PAGE",
          "MISSING_INVOICE_NUMBER",
          "MISSING_INVOICE_DATE",
          "MIXED_LANGUAGE",
          "TABLE_STRUCTURE_UNCERTAIN",
          "TOTALS_MISMATCH",
          "MANUAL_REVIEW_REQUIRED"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "evidenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawValue",
        "normalizedValue",
        "page",
        "boundingBox",
        "evidenceText",
        "warnings"
      ],
      "properties": {
        "rawValue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "normalizedValue": true,
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "boundingBox": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundingBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "textField": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenceBase"
        },
        {
          "type": "object",
          "properties": {
            "normalizedValue": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        }
      ]
    },
    "decimalField": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenceBase"
        },
        {
          "type": "object",
          "properties": {
            "normalizedValue": {
              "oneOf": [
                {
                  "$ref": "#/$defs/decimalString"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "dateField": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenceBase"
        },
        {
          "type": "object",
          "properties": {
            "normalizedValue": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "currencyField": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenceBase"
        },
        {
          "type": "object",
          "properties": {
            "normalizedValue": {
              "enum": [
                "EGP",
                null
              ]
            }
          }
        }
      ]
    },
    "sourceLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLineId",
        "sequence",
        "description",
        "vendorItemCode",
        "quantity",
        "unit",
        "purchaseUnitPrice",
        "discount1Percentage",
        "discount2Percentage",
        "sellingUnitPrice",
        "expiryDate",
        "batch"
      ],
      "properties": {
        "sourceLineId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "$ref": "#/$defs/textField"
        },
        "vendorItemCode": {
          "$ref": "#/$defs/textField"
        },
        "quantity": {
          "$ref": "#/$defs/decimalField"
        },
        "unit": {
          "$ref": "#/$defs/textField"
        },
        "purchaseUnitPrice": {
          "$ref": "#/$defs/decimalField"
        },
        "discount1Percentage": {
          "$ref": "#/$defs/decimalField"
        },
        "discount2Percentage": {
          "$ref": "#/$defs/decimalField"
        },
        "sellingUnitPrice": {
          "$ref": "#/$defs/decimalField"
        },
        "expiryDate": {
          "$ref": "#/$defs/dateField"
        },
        "batch": {
          "$ref": "#/$defs/textField"
        }
      }
    }
  }
}
