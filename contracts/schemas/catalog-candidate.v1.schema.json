{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pharma-auto.invalid/v1/catalog-candidate.schema.json",
  "title": "Local Catalog Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "localItemReference",
    "displayLabel",
    "rawLabel",
    "rawLabelHash",
    "labelSource",
    "displayDirection",
    "qualityFlags",
    "identifiers",
    "attributes",
    "reasonCodes",
    "hardMismatches",
    "requiresManualConfirmation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "localItemReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "displayLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "rawLabel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "rawLabelHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "labelSource": {
      "enum": [
        "GENIUS_RAW",
        "CANONICAL_CATALOG",
        "MANUAL_CONFIRMATION",
        "IDENTIFIER_ONLY"
      ]
    },
    "displayDirection": {
      "enum": [
        "AUTO",
        "LTR",
        "RTL"
      ]
    },
    "qualityFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNVERIFIED",
          "LANGUAGE_FIELDS_IDENTICAL",
          "EMPTY_OR_BLANK",
          "MALFORMED_BIDI",
          "TRUNCATED_OR_CORRUPT",
          "CANONICAL_OVERLAY_AVAILABLE",
          "MANUALLY_CONFIRMED"
        ]
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemCode",
        "secondaryCode",
        "internationalCode",
        "vendorItemCodes",
        "barcodes"
      ],
      "properties": {
        "itemCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "secondaryCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "internationalCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "vendorItemCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "barcodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeIngredient",
        "strength",
        "dosageForm",
        "pack"
      ],
      "properties": {
        "activeIngredient": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        },
        "strength": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "dosageForm": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "pack": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXACT_IDENTIFIER",
          "VENDOR_ITEM_CODE",
          "PREVIOUS_CONFIRMED_MAPPING",
          "EXACT_NORMALIZED_NAME",
          "STRUCTURED_ATTRIBUTES",
          "CANONICAL_SHORTLIST",
          "WEAK_RAW_LABEL",
          "MANUAL_CATALOG_SEARCH"
        ]
      }
    },
    "hardMismatches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACTIVE_INGREDIENT",
          "STRENGTH",
          "DOSAGE_FORM",
          "PACK"
        ]
      }
    },
    "requiresManualConfirmation": {
      "const": true
    }
  }
}
