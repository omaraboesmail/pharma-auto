{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pharma-auto.invalid/v1/invoice-job.schema.json",
  "title": "Read-Only Invoice Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "state",
    "deviceId",
    "pageCount",
    "uploadedPageCount",
    "currentRevisionId",
    "createdAt",
    "updatedAt",
    "failureCode",
    "geniusWritePerformed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "CAPTURED",
        "LOCALLY_VALIDATED",
        "OCR_RESERVED",
        "OCR_PROCESSING",
        "OCR_VALIDATED",
        "MATCHING",
        "AWAITING_USER_REVIEW",
        "CONFIRMED",
        "REJECTED",
        "OCR_FAILED",
        "MATCHING_FAILED"
      ]
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "uploadedPageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "currentRevisionId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "failureCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "geniusWritePerformed": {
      "const": false
    }
  }
}
