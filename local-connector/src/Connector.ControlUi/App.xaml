<Application x:Class="PharmaAuto.Connector.ControlUi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CounterForest" Color="#075D35" />
    <SolidColorBrush x:Key="DeepForest" Color="#00391F" />
    <SolidColorBrush x:Key="FreshConfirmation" Color="#E8F5EB" />
    <SolidColorBrush x:Key="CounterInk" Color="#171D19" />
    <SolidColorBrush x:Key="QuietCanvas" Color="#F9FBF7" />
    <SolidColorBrush x:Key="CleanSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CoolSurface" Color="#F0F3EF" />
    <SolidColorBrush x:Key="MeasuredOutline" Color="#C0C9C1" />
    <SolidColorBrush x:Key="EvidenceAmber" Color="#8A5100" />
    <SolidColorBrush x:Key="EvidenceAmberContainer" Color="#FFDDB5" />
    <SolidColorBrush x:Key="RecoveryRed" Color="#BA1A1A" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource CounterInk}" />
      <Setter Property="Background" Value="{StaticResource QuietCanvas}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DeepForest}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource CounterForest}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource CleanSurface}" />
      <Setter Property="Foreground" Value="{StaticResource CounterForest}" />
      <Setter Property="BorderBrush" Value="{StaticResource MeasuredOutline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MeasuredOutline}" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowHeight" Value="44" />
      <Setter Property="ColumnHeaderHeight" Value="40" />
      <Setter Property="Background" Value="{StaticResource CleanSurface}" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
  </Application.Resources>
</Application>
