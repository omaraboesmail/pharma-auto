<Window x:Class="PharmaAuto.Connector.ControlUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharma Auto Connector"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource CleanSurface}" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="0,0,0,1">
      <Grid Margin="28,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Pharma Auto Connector" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Local service, pairing and catalog health / الخدمة المحلية والإقران وحالة الفهرس"
                     Margin="0,5,0,0"
                     Foreground="#4F5A52"
                     FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="11" Height="11" Margin="0,0,9,0" Fill="{Binding StatusBrush}" />
          <TextBlock Text="{Binding ServiceStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Style="{StaticResource SecondaryButton}"
                  Margin="18,0,0,0"
                  Content="Refresh / تحديث"
                  Click="Refresh_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,24,28,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="570" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="2*" MinWidth="350" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource FreshConfirmation}" CornerRadius="12" Padding="20">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Local service / الخدمة المحلية" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PharmacyName}" Margin="0,7,0,0" FontSize="15" />
              <TextBlock Text="{Binding BaseUrl}" Margin="0,3,0,0" Foreground="#4F5A52" />
              <TextBlock Text="Genius writes are disabled in Phase 1 / الكتابة إلى Genius مغلقة"
                         Margin="0,10,0,0"
                         Foreground="{StaticResource DeepForest}"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
              <TextBlock Text="Queue / الطابور" Foreground="#4F5A52" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding QueueDepth}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource CleanSurface}" CornerRadius="12" Padding="18" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Catalog Items / الأصناف" Foreground="#4F5A52" />
              <TextBlock Text="{Binding ItemCount}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource CleanSurface}" CornerRadius="12" Padding="18" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Identifiers / المعرّفات" Foreground="#4F5A52" />
              <TextBlock Text="{Binding IdentifierCount}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Background="{StaticResource EvidenceAmberContainer}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="Untrusted labels / أسماء غير موثقة" Foreground="{StaticResource EvidenceAmber}" />
              <TextBlock Text="{Binding UntrustedLabelCount}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="{StaticResource EvidenceAmber}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Invoice queue / طابور الفواتير" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Read-only progress from capture to confirmed review"
                         Foreground="#4F5A52" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Content="Rebuild catalog / إعادة بناء الفهرس"
                    Click="RebuildCatalog_Click" />
          </Grid>
          <Border Grid.Row="1" Background="{StaticResource CleanSurface}" CornerRadius="12" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="State / الحالة" Binding="{Binding State}" Width="1.5*" />
                <DataGridTextColumn Header="Pages / الصفحات" Binding="{Binding Pages}" Width="*" />
                <DataGridTextColumn Header="Updated / آخر تحديث" Binding="{Binding Updated}" Width="1.5*" />
                <DataGridTextColumn Header="Issue / المشكلة" Binding="{Binding FailureCode}" Width="1.5*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="Pair Android device / إقران جهاز Android" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="The code expires after five minutes and can be used once."
                     Foreground="#4F5A52" Margin="0,4,0,0" TextWrapping="Wrap" />
          <Button Style="{StaticResource PrimaryButton}"
                  Margin="0,14,0,0"
                  Content="Create one-time QR / إنشاء QR لمرة واحدة"
                  Click="CreatePairing_Click" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,24" Background="{StaticResource CleanSurface}" CornerRadius="12" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1" Padding="18">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="232" Height="232" Background="White" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1" Padding="8">
              <Grid>
                <TextBlock Text="Create a one-time code"
                           Foreground="#707972"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding QrPlaceholderVisibility}" />
                <Image Source="{Binding PairingQr}" Stretch="Uniform" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding PairingExpiry}" Margin="0,12,0,0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PairingHint}" Margin="0,4,0,0" Foreground="#4F5A52" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Paired devices / الأجهزة المقترنة" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Border Grid.Row="1" Background="{StaticResource CleanSurface}" CornerRadius="12" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Device / الجهاز" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn Header="Status / الحالة" Binding="{Binding Status}" Width="*" />
                <DataGridTemplateColumn Header="Action / إجراء" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Revoke / إلغاء"
                              MinHeight="34"
                              Margin="4"
                              Padding="10,4"
                              Background="White"
                              Foreground="{StaticResource RecoveryRed}"
                              BorderBrush="{StaticResource MeasuredOutline}"
                              BorderThickness="1"
                              IsEnabled="{Binding CanRevoke}"
                              Click="RevokeDevice_Click" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource CleanSurface}" BorderBrush="{StaticResource MeasuredOutline}" BorderThickness="0,1,0,0" Padding="28,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageBrush}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding LastRefreshed}" Foreground="#707972" Margin="18,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding BusyVisibility}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Width="220" Height="6" IsIndeterminate="True" Foreground="{StaticResource CounterForest}" />
        <TextBlock Text="Working… / جارٍ التنفيذ…" Margin="0,14,0,0" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
